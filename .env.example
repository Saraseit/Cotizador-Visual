# ============================================================================
# Cotizador visual — variables de entorno
# Copia este archivo a `.env` en la raíz del repo. El backend lo lee desde ahí
# (también desde backend/.env) y Vite lee las variables VITE_* desde frontend/.env
# o desde este mismo archivo si arrancas Vite con `--mode` apuntando aquí.
# ============================================================================

# ---------------------------------------------------------------- Backend ---

# URL del proyecto de Supabase (Dashboard > Project Settings > API).
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Service role key (Dashboard > Project Settings > API Keys). Ignora RLS: sólo en el backend.
SUPABASE_SERVICE_ROLE_KEY=

# JWT secret heredado (Dashboard > Project Settings > JWT Keys > Legacy JWT Secret).
# Sólo hace falta si los tokens del proyecto se firman con HS256. Con llaves asimétricas
# (ES256, el valor por defecto en proyectos nuevos) se deja vacío y se usa el endpoint JWKS.
SUPABASE_JWT_SECRET=

# URL del JWKS. Opcional: si se omite se deriva de SUPABASE_URL (/auth/v1/.well-known/jwks.json).
# SUPABASE_JWKS_URL=

# Nombres de los buckets privados de Storage (los crea la migración 20260918000002).
BUCKET_IMAGENES=imagenes
BUCKET_EXPORTS=exports

# Duración en segundos de las URLs firmadas que se entregan al frontend.
URL_FIRMADA_SEGUNDOS=600

# Proveedor de generación de imágenes: 'openai' (gpt-image-1) o 'simulado' (sin llamadas externas,
# devuelve la imagen base con un tinte; útil para desarrollar sin gastar créditos).
# Si es 'openai' pero OPENAI_API_KEY está vacía, el backend cae solo a 'simulado' y lo avisa en /api/salud.
PROVEEDOR_IMAGENES=openai

# API key de OpenAI. Vacía = proveedor simulado.
OPENAI_API_KEY=

# Topes de generaciones con IA en 24 h (cada llamada cuenta 1 aunque produzca 4 imágenes). Nadie está exento.
LIMITE_GENERACIONES_DIARIAS_USUARIO=20
LIMITE_GENERACIONES_DIARIAS_GLOBAL=100

# Modelo y calidad de gpt-image-1 ('low' | 'medium' | 'high'). La calidad afecta costo y tiempo.
OPENAI_MODELO_IMAGENES=gpt-image-1
OPENAI_CALIDAD_IMAGENES=medium

# Cuántas variantes se generan por petición.
VARIANTES_POR_GENERACION=4

# Prompt de estilo fijo que se antepone a la petición del vendedor. Si se omite se usa el valor
# por defecto de backend/app/config.py (conservar forma, ángulo 3/4, fondo neutro, luz lateral, etc.).
# PROMPT_ESTILO_FIJO=

# Orígenes permitidos para CORS, separados por coma. Vacía: en ENTORNO=desarrollo se aceptan
# http://localhost:5173 y cualquier https://*.vercel.app; en ENTORNO=produccion es obligatoria
# (el backend no arranca sin ella y lo dice en el log).
CORS_ORIGENES=

# Ruta al mapeo de columnas del export (relativa a backend/).
MAPEO_COLUMNAS_RUTA=fixtures/mapeo_columnas.json

# desarrollo | produccion. En produccion CORS_ORIGENES es obligatoria; en desarrollo se aceptan *.vercel.app.
ENTORNO=desarrollo

# Puerto del backend. Railway lo inyecta automáticamente; en local lo define uvicorn.
# PORT=8000

# --------------------------------------------------------------- Frontend ---
# Estas van en frontend/.env (local) y en las variables del proyecto de Vercel.

# Misma URL del proyecto de Supabase.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Anon/publishable key de Supabase (segura para el navegador; RLS aplica).
VITE_SUPABASE_ANON_KEY=

# URL base del backend, sin barra final (local: http://localhost:8000; producción: dominio de Railway).
VITE_API_URL=http://localhost:8000
