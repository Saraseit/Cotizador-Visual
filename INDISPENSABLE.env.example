# Las únicas variables sin valor por defecto. Todo lo demás (.env.example) es opcional.
# Backend (Railway) usa las 3 primeras + OPENAI_API_KEY; frontend (Vercel) usa las VITE_* y VITE_API_URL.
SUPABASE_URL=                 # Supabase → Project Settings → API → Project URL
SUPABASE_SERVICE_ROLE_KEY=    # Supabase → Project Settings → API Keys → service_role (secreta, sólo backend)
VITE_SUPABASE_URL=            # mismo valor que SUPABASE_URL
VITE_SUPABASE_ANON_KEY=       # Supabase → Project Settings → API Keys → anon / publishable
OPENAI_API_KEY=               # platform.openai.com → API keys (vacío = proveedor simulado, sin costo)
VITE_API_URL=                 # dominio público del backend en Railway, sin barra final (Railway → servicio → Settings → Networking)
